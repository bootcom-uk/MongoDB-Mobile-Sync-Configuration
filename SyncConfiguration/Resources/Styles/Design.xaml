<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <Color x:Key="CanvasLight">#F3F5F8</Color>
  <Color x:Key="CanvasDark">#111821</Color>
  <Color x:Key="SurfaceLight">#FFFFFF</Color>
  <Color x:Key="SurfaceDark">#1B2532</Color>
  <Color x:Key="InkLight">#172B40</Color>
  <Color x:Key="InkDark">#EDF2F7</Color>
  <Color x:Key="MutedLight">#536579</Color>
  <Color x:Key="MutedDark">#ACBDCF</Color>
  <Color x:Key="LineLight">#DCE3EC</Color>
  <Color x:Key="LineDark">#344255</Color>
  <Color x:Key="ActionLight">#245BC4</Color>
  <Color x:Key="ActionDark">#9AC1FF</Color>

  <Style TargetType="Page" ApplyToDerivedTypes="True">
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}" />
  </Style>
  <Style TargetType="ContentPage">
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}" />
  </Style>
  <Style TargetType="Label">
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="PageTitle" TargetType="Label">
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="Label" BasedOn="{StaticResource PageTitle}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
  </Style>
  <Style x:Key="MutedText" TargetType="Label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="Label">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
  </Style>
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=#102342}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="MinimumHeightRequest" Value="44" />
    <Setter Property="VisualStateManager.VisualStateGroups">
      <VisualStateGroupList><VisualStateGroup x:Name="CommonStates">
        <VisualState x:Name="Normal" />
        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState>
        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Property="Opacity" Value="0.85" /></VisualState.Setters></VisualState>
      </VisualStateGroup></VisualStateGroupList>
    </Setter>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}" />
    <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
    <Setter Property="BorderWidth" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinimumHeightRequest" Value="44" />
    <Style.Triggers><Trigger TargetType="Button" Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="Entry" ApplyToDerivedTypes="True">
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}" />
    <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinimumHeightRequest" Value="44" />
  </Style>
  <Style TargetType="Editor">
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style TargetType="Picker">
    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
    <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinimumHeightRequest" Value="44" />
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Color" Value="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}" /></Style>
  <Style TargetType="CollectionView"><Setter Property="BackgroundColor" Value="Transparent" /></Style>
  <Style TargetType="NavigationPage">
    <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
    <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource ActionLight}, Dark={StaticResource ActionDark}}" />
  </Style>
</ResourceDictionary>
